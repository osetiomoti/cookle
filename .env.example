# .env.example — くっくる（Cookcle）環境変数テンプレート
# .env をコピーして実際の値を設定してください

# --- DATABASE (Prisma / Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/cookle?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/cookle?sslmode=require"

# --- AWS Cognito (Auth) ---
COGNITO_REGION="ap-northeast-1"
COGNITO_USER_POOL_ID="ap-northeast-1_xxxxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
COGNITO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
COGNITO_DOMAIN="xxxx.auth.ap-northeast-1.amazoncognito.com"

# --- AWS Cognito Identity Pool (S3 Credentials) ---
COGNITO_IDENTITY_POOL_ID="ap-northeast-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- AWS S3 (Storage) ---
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET_NAME="cookle-media-prod"

# --- CloudFront (Image CDN) ---
NEXT_PUBLIC_CLOUDFRONT_DOMAIN="xxxxxxxxxxxx.cloudfront.net"

# --- App Settings ---
NEXT_PUBLIC_APP_URL="http://localhost:3100"

